# Node 
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Supabase 
# Project URL (from Supabase dashboard → Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key (safe to use server-side for user-scoped operations)
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service-role key — NEVER expose to clients; used only for admin/webhook paths
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay 
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# API key secret — NEVER logged or returned in any response
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Webhook secret — SEPARATE from the API key secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# CORS 
# Comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# Email (Resend) 
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=orders@muvira.com

# Store Config 
ORDER_PREFIX=MUV
STORE_NAME=Muvira

# Cache (node-cache in-memory)
# Set to false to bypass the cache entirely (useful for debugging / integration tests)
CACHE_ENABLED=true
# Set to true to log every HIT / MISS / SET / DELETE in development
CACHE_DEBUG=false

# Shiprocket
# Used to proxy AWB tracking requests — credentials never exposed to the client
SHIPROCKET_EMAIL=your@email.com
SHIPROCKET_PASSWORD=your-shiprocket-password
# Production requires webhook delivery and a unique secret configured in both systems.
# Development may explicitly set this to false while using polling-only workflows.
SHIPROCKET_WEBHOOK_ENABLED=false
SHIPROCKET_WEBHOOK_SECRET=replace-with-at-least-16-characters
