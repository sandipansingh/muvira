# Backend API (leave empty in dev — Vite proxy forwards /api/* to localhost:4000)
VITE_API_URL=

# Supabase (same project URL and anon key as the backend's SUPABASE_URL / SUPABASE_ANON_KEY)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Store display name
VITE_STORE_NAME=Muvira

# Optional: Force a specific redirect URL for Supabase email verification / password reset
# If not set, the app will automatically use the current domain (recommended)
# VITE_AUTH_REDIRECT_URL=https://muvira.in/
