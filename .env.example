# Public storefront configuration (embedded into the client image at build time)
VITE_API_URL=https://api.example.com
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_STORE_NAME=Muvira
VITE_AUTH_REDIRECT_URL=https://shop.example.com

# Server-only configuration (never pass service-role or provider secrets as build args)
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
ALLOWED_ORIGINS=https://shop.example.com
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=orders@example.com
ORDER_PREFIX=MUV
STORE_NAME=Muvira
CACHE_ENABLED=true
CACHE_DEBUG=false
SHIPROCKET_EMAIL=your-shiprocket-email@example.com
SHIPROCKET_PASSWORD='your-shiprocket-password'
SHIPROCKET_WEBHOOK_ENABLED=true
SHIPROCKET_WEBHOOK_SECRET=replace-with-at-least-16-characters
