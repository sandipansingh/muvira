# Backend API (leave empty in dev — Vite proxy forwards /api/* to localhost:4000)
VITE_API_URL=

# Supabase (same project URL and anon key as the backend's SUPABASE_URL / SUPABASE_ANON_KEY)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Razorpay public key (rzp_test_... or rzp_live_...)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Store display name
VITE_STORE_NAME=Muvira

# Supabase Storage:
# 1. In your Supabase project dashboard, create a PUBLIC bucket named "images"
# 2. Recommended folders will be auto-created: products/, categories/, campaigns/
# All image uploads from admin now use device files via Supabase Storage instead of manual URLs.
