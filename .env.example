# Public storefront configuration (embedded into the client image at build time)
VITE_API_URL=https://api.example.com
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_STORE_NAME=Muvira
VITE_AUTH_REDIRECT_URL=https://shop.example.com
# Used by Vite development only. The production host injects public runtime settings.
VITE_SITE_URL=https://muvira.in
VITE_SEO_INDEXING_ENABLED=false

# Frontend Node host runtime (never expose SEO_INTERNAL_TOKEN through VITE_* or build args)
SITE_URL=https://muvira.in
SEO_API_URL=https://api.example.com
# Required at runtime: true for production, false for staging. No default.
SEO_INDEXING_ENABLED=true
# Set the same randomly generated value on the API and frontend host (at least 32 characters).
SEO_INTERNAL_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# Server-only configuration (never pass service-role or provider secrets as build args)
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
SCHEMA_RELEASE_MODE=final
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_MODE=live
# Confirm account availability before enabling intent or redirect QR.
RAZORPAY_UPI_INTENT_ENABLED=false
RAZORPAY_UPI_QR_ENABLED=false
# Enable only after explicit Razorpay approval for embedded desktop QR.
RAZORPAY_UPI_EMBEDDED_QR_APPROVED=false
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
ALLOWED_ORIGINS=https://shop.example.com
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=orders@example.com
ORDER_PREFIX=MUV
STORE_NAME=Muvira
CACHE_ENABLED=true
CACHE_DEBUG=false
SHIPROCKET_EMAIL=your-shiprocket-email@example.com
SHIPROCKET_PASSWORD='your-shiprocket-password'
SHIPROCKET_WEBHOOK_ENABLED=true
SHIPROCKET_WEBHOOK_SECRET=replace-with-at-least-16-characters
