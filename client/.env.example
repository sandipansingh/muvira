# Backend API (leave empty in dev — Vite proxy forwards /api/* to localhost:4000)
VITE_API_URL=

# Supabase (same project URL and anon key as the backend's SUPABASE_URL / SUPABASE_ANON_KEY)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Razorpay public key (rzp_test_... or rzp_live_...)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Store display name
VITE_STORE_NAME=Muvira
