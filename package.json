{
  "name": "muvira-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "pnpm --filter client exec tsc -b && pnpm --filter server type-check",
    "test": "pnpm run build && node --test tests/*.test.cjs",
    "test:contracts": "node --test tests/contracts.test.cjs",
    "db:start": "pnpm --filter server exec supabase start --workdir ..",
    "db:reset": "pnpm --filter server exec supabase db reset --workdir .. --local --no-seed",
    "db:test": "SUPABASE_TELEMETRY_DISABLED=true DO_NOT_TRACK=1 CI=true pnpm --filter server exec supabase test db --workdir .. --local ../supabase/tests/database_integrity.test.sql",
    "db:stop": "pnpm --filter server exec supabase stop --workdir .. --no-backup",
    "db:migrate": "bash scripts/push-supabase-migrations.sh",
    "dev": "pnpm -r --parallel run dev",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm -r run build",
    "install:all": "pnpm install",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "playwright": "^1.63.0",
    "prettier": "^3.8.4",
    "typescript-eslint": "^8.62.0"
  }
}
