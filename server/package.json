{
  "name": "server",
  "version": "1.0.0",
  "description": "Muvira e-commerce REST API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "pnpm run build && node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "type-check": "tsc --noEmit",
    "lint": "pnpm --dir .. run lint",
    "format": "pnpm --dir .. run format"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.8",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.5.0",
    "pino": "^8.19.0",
    "pino-http": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "razorpay": "^2.9.2",
    "resend": "^3.2.0",
    "uuid": "^11.1.1",
    "ws": "^8.21.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "4.19.9",
    "@types/node": "^20.11.30",
    "@types/node-cache": "^4.1.3",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.0",
    "supabase": "^2.107.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
